{
  "_doc": [
      "Level layout for a one-button level. Segments play in order; 'bars' is each one's length (keep the total at the excerpt's bar count),",
      "then re-run: python tools/chart.py skyhigh",
      "lap = beats per trip round a ring (smaller = faster: double-time; larger = half-time).  shape: circle | ellipse | square.",
      "jump: out (default) or in.  rocket: extra rings the ball launches through on entering.  reverse / revEvery: direction flips.",
      "look: palette, bg (stars | tunnel | grid), eq (bars | wave | burst), optional [from, to] ramps: zoom, rot (turns), tilt, drain, vignette; flip.",
      "warn: label shown two beats before the section.  teach: banner the first time.  plan: one pattern per bar (vocabulary at the top of tools/chart.py)."
  ],
  "id": "skyhigh",
  "title": "Sky High",
  "artist": "Elektronomia",
  "release": "NCS Release",
  "hitsoundNote": 72,
  "segments": [
    {"id": "intro", "bars": 4, "label": "INTRO", "lap": 8, "lead": "snare", "teach": "TAP as the ball crosses each gate", "look": {"palette": "deep", "bg": "stars", "eq": "bars", "zoom": [0.9, 1]},
      "plan": ["-", "L=@x...x...x...x...", "L=@x...x...x.x.x...", "L=@x.x.x...x.x.x..."] },
    {"id": "intro2", "bars": 4, "label": "INTRO", "lap": 8, "lead": "snare", "teach": "DOUBLES: two quick taps on one ring", "look": {"palette": "ocean", "bg": "stars", "eq": "bars"},
      "plan": ["L=@x.x.x...x.x.x...", "L=@x.xx....x.xx....", "L=@x.xx..x.x.xx..x.", "L=@X.......x...x..."] },
    {"id": "verse", "bars": 4, "label": "VERSE", "lap": 8, "lead": "snare", "shape": "ellipse", "reverse": true, "warn": "REVERSE", "teach": "REVERSE: the ball turns round", "look": {"palette": "violet", "bg": "tunnel", "eq": "wave"},
      "plan": ["L=@X.x.......x...x.", "L=@..x...x.x...x.x.", "L=@x.x...x.x.xx..x.", "L=@x.x.x.x...x.x.x."] },
    {"id": "ghost", "bars": 4, "label": "VERSE", "lap": 8, "lead": "snare", "shape": "ellipse", "warn": "GHOST GATES", "teach": "GHOST GATES fade out: keep the rhythm", "look": {"palette": "violet", "bg": "tunnel", "eq": "wave", "rot": [0, 0.25]},
      "plan": ["L=@x...x...x...x...", "L=@x...x...x...x... B=off ghost=B late", "L=@x.x.x...x.x.x...", "L=@x...x...x....... B=off ghost=B"] },
    {"id": "spikes", "bars": 4, "label": "BUILD", "lap": 4, "lead": "snare", "jump": "in", "warn": "SPIKES", "teach": "SPIKES: tap the pad to hop over", "look": {"palette": "dusk", "bg": "grid", "eq": "bars", "zoom": [1, 1.06]},
      "plan": ["B=@....x.......x... hop", "B=@x...x...x....... hop", "B=@x...x...x...x... hop L=@..x...x...x.....", "B=@x...x...x...x.x. hop L=@..x...x...x....."] },
    {"id": "rush", "bars": 2, "label": "BUILD", "lap": 2, "lead": "snare", "jump": "in", "warn": "DOUBLE TIME", "look": {"palette": "dusk", "bg": "grid", "eq": "bars", "zoom": [1.06, 1.18], "drain": [0, 0.5], "vignette": [0, 0.5]},
      "plan": ["B=@x...x...x...x... L=@..xx..x...xx..x."] },
    {"id": "roll", "bars": 2, "label": "BUILD", "lap": 2, "lead": "full", "jump": "in", "look": {"palette": "dusk", "bg": "grid", "eq": "bars", "zoom": [1.18, 1.4], "drain": [0.5, 0.95], "vignette": [0.5, 0.9]},
      "plan": ["L=@x.x.x.x.x.x.x.x.", "L=@x.xxx.xxx.xxx.xx"] },
    {"id": "count", "bars": 1, "label": "READY", "lap": 4, "blackout": true, "count": true, "jump": "in", "look": {"palette": "dusk", "bg": "stars", "eq": "bars", "zoom": [1.4, 1.5], "drain": [1, 1], "vignette": [0.9, 1]},
      "plan": ["B=@............X.x."] },
    {"id": "drop1", "bars": 4, "label": "DROP", "lap": 4, "motif": "drop", "cycle": 4, "shape": "square", "rocket": 4, "enter": "drop", "look": {"palette": "neon", "bg": "tunnel", "eq": "burst", "zoom": [0.94, 1]},
      "plan": ["B=16 stack run=3", "B=16 run=3", "B=16 run=3", "B=16 L=8 run=3"] },
    {"id": "drop2", "bars": 3, "label": "DROP", "lap": 4, "motif": "drop", "cycle": 4, "shape": "square", "enter": "pulse", "look": {"palette": "aqua", "bg": "tunnel", "eq": "burst"},
      "plan": ["B=8 L=16 run=3", "B=8 L=16 run=3 ghost=B", "B=8 L=16 run=3 ghost=B"] },
    {"id": "breath", "bars": 1, "label": "DROP", "lap": 8, "motif": "drop", "cycle": 4, "shape": "square", "jump": "in", "warn": "HALF TIME", "look": {"palette": "aqua", "bg": "stars", "eq": "wave", "zoom": [1, 1.1]},
      "plan": ["B=@............x.x. L=@..x...x...x....."] },
    {"id": "drop3", "bars": 4, "label": "DROP", "lap": 4, "motif": "drop", "cycle": 4, "shape": "square", "revEvery": 1, "rocket": 2, "enter": "pulse", "warn": "REVERSES", "look": {"palette": "gold", "bg": "grid", "eq": "burst", "rot": [0, 1]},
      "plan": ["B=16 L=8 stack run=3", "B=8 L=16 run=3", "B=16 L=8 run=3", "B=8 L=16 run=3"] },
    {"id": "drop4", "bars": 4, "label": "DROP", "lap": 4, "motif": "drop", "cycle": 4, "shape": "circle", "enter": "pulse", "look": {"palette": "hot", "bg": "tunnel", "eq": "burst", "zoom": [1, 1.12], "flip": true},
      "plan": ["B=16 L=16 stack run=3", "B=16 L=16 run=3", "B=16 L=16 stack run=3", "B=@X.x.x.x.x.xxx.x. L=@..x...x..x.x...."] },
    {"id": "outro", "bars": 1, "label": "END", "lap": 8, "rocket": 6, "enter": "flash", "look": {"palette": "deep", "bg": "stars", "eq": "wave", "zoom": [1.12, 0.95]},
      "plan": ["B=@X..............."] }
  ]
}
