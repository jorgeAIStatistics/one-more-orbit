{
  "_doc": [
    "Level layout. Segments play in order; 'bars' is each one's length, so pacing is tuned by changing bars here",
    "(keep the total at the excerpt's bar count) and re-running: python tools/chart.py skyhigh",
    "mode: tap | hold | colour | dodge | spinner | dual.  lap = beats per trip round the ring.",
    "look: palette name plus optional [from, to] ramps across the segment: zoom, rot (camera turns), drain (colour loss), vignette, ring (ring size).",
    "gen: how the chart tool picks notes per difficulty (N/H/I): grid 4/8/16 = finest note value, n / nL / nR = notes per bar",
    "(any / cyan-left / pink-right), run = longest burst at grid speed, alt = one hand at a time, chords = both hands may hit together."
  ],
  "id": "skyhigh",
  "title": "Sky High",
  "artist": "Elektronomia",
  "release": "NCS Release",
  "hitsoundNote": 72,
  "segments": [
    { "id": "intro", "bars": 4, "label": "INTRO", "mode": "tap", "lap": 8,
      "teach": "TAP as the ball crosses each gate",
      "look": { "palette": "deep", "zoom": [0.9, 1] },
      "gen": { "N": { "grid": 4, "n": 2, "first": 1 }, "H": { "grid": 8, "n": 3, "run": 2, "first": 1 }, "I": { "grid": 8, "n": 4.5, "run": 3, "first": 1 } } },
    { "id": "intro2", "bars": 4, "label": "INTRO", "mode": "tap", "lap": 8, "dir": -1,
      "look": { "palette": "ocean" },
      "gen": { "N": { "grid": 8, "n": 4, "run": 2 }, "H": { "grid": 8, "n": 5, "run": 3 }, "I": { "grid": 16, "n": 7, "run": 3 } } },
    { "id": "runs", "bars": 4, "label": "VERSE", "mode": "hold", "lap": 8,
      "teach": "HOLD the long arcs, let go at the end",
      "look": { "palette": "violet" },
      "gen": { "N": { "hand": "A", "grid": 8, "n": 2, "minRun": 4 }, "H": { "hand": "R", "grid": 8, "n": 2, "nL": 2, "minRun": 4, "run": 2 }, "I": { "hand": "R", "grid": 16, "n": 3, "nL": 3, "minRun": 4, "run": 3 } } },
    { "id": "colour", "bars": 4, "label": "VERSE", "mode": "colour", "lap": 4,
      "teach": "CYAN = tap LEFT   PINK = tap RIGHT",
      "look": { "palette": "split" },
      "gen": { "N": { "grid": 8, "nL": 2, "nR": 3, "run": 3, "alt": true }, "H": { "grid": 16, "nL": 2.5, "nR": 3.5, "run": 3, "chords": true }, "I": { "grid": 16, "nL": 3.5, "nR": 5.5, "run": 4, "chords": true } } },
    { "id": "dodge", "bars": 4, "label": "BUILD", "mode": "dodge", "lap": 4,
      "teach": "DODGE the red blocks: tap to hop lanes",
      "look": { "palette": "dusk", "zoom": [1, 1.06] },
      "gen": { "N": { "grid": 4, "n": 3, "pattern": "1100" }, "H": { "grid": 8, "n": 4.5, "pattern": "1001" }, "I": { "grid": 8, "n": 6, "pattern": "10" } } },
    { "id": "rush", "bars": 2, "label": "BUILD", "mode": "colour", "lap": 2,
      "look": { "palette": "dusk", "zoom": [1.06, 1.2], "drain": [0, 0.55], "vignette": [0, 0.5], "ring": [1, 0.84] },
      "gen": { "N": { "grid": 8, "nL": 3, "nR": 4, "run": 4, "alt": true }, "H": { "grid": 16, "nL": 3, "nR": 5, "run": 4, "chords": true }, "I": { "grid": 16, "nL": 4, "nR": 8, "run": 8, "chords": true } } },
    { "id": "spin", "bars": 2, "label": "BUILD", "mode": "spinner", "lap": 1,
      "teach": "SPIN! Tap as fast as you can",
      "look": { "palette": "dusk", "zoom": [1.2, 1.42], "drain": [0.55, 0.95], "vignette": [0.5, 0.9], "ring": [0.84, 0.64] },
      "gen": { "N": { "rate": 5 }, "H": { "rate": 7 }, "I": { "rate": 9 } } },
    { "id": "count", "bars": 1, "label": "READY", "mode": "colour", "lap": 2, "blackout": true, "count": true,
      "look": { "palette": "dusk", "zoom": [1.42, 1.5], "drain": [1, 1], "vignette": [0.9, 1], "ring": [0.64, 0.58] },
      "gen": { "N": { "grid": 8, "nL": 1, "nR": 1, "thr": 0.5, "alt": true }, "H": { "grid": 16, "nL": 1, "nR": 2, "thr": 0.5 }, "I": { "grid": 16, "nL": 2, "nR": 2, "thr": 0.45, "chords": true } } },
    { "id": "drop1", "bars": 4, "label": "DROP", "mode": "dual", "lap": 4, "enter": "drop",
      "look": { "palette": "neon", "zoom": [0.94, 1] },
      "gen": { "N": { "grid": 8, "nL": 3, "nR": 3, "run": 3, "alt": true, "forceL": [0] }, "H": { "grid": 16, "nL": 3.5, "nR": 4, "run": 3, "chords": true, "forceL": [0], "forceR": [0] }, "I": { "grid": 16, "nL": 5, "nR": 6, "run": 4, "chords": true, "forceL": [0], "forceR": [0] } } },
    { "id": "drop2", "bars": 4, "label": "DROP", "mode": "dual", "lap": 4, "holds": true, "enter": "pulse",
      "look": { "palette": "aqua", "zoom": [1, 0.9] },
      "gen": { "N": { "grid": 8, "nL": 3, "nR": 2.5, "run": 3, "alt": true, "minRun": 4 }, "H": { "grid": 16, "nL": 4, "nR": 3.5, "run": 3, "chords": true, "minRun": 4 }, "I": { "grid": 16, "nL": 6, "nR": 5, "run": 5, "chords": true, "minRun": 4 } } },
    { "id": "drop3", "bars": 4, "label": "DROP", "mode": "dual", "lap": 4, "counter": true, "swap": true, "revEvery": 1, "enter": "pulse",
      "look": { "palette": "gold", "rot": [0, 1], "zoom": [0.9, 1] },
      "gen": { "N": { "grid": 8, "nL": 3, "nR": 3.5, "run": 4, "alt": true }, "H": { "grid": 16, "nL": 4, "nR": 4.5, "run": 3, "chords": true }, "I": { "grid": 16, "nL": 6, "nR": 7, "run": 6, "chords": true } } },
    { "id": "drop4", "bars": 4, "label": "DROP", "mode": "dual", "lap": 4, "counter": true, "enter": "pulse",
      "look": { "palette": "hot", "zoom": [1, 1.12] },
      "gen": { "N": { "grid": 8, "nL": 4, "nR": 4, "run": 6, "alt": true }, "H": { "grid": 16, "nL": 5, "nR": 5, "run": 4, "chords": true }, "I": { "grid": 16, "nL": 7, "nR": 9, "run": 16, "chords": true } } },
    { "id": "outro", "bars": 1, "label": "END", "mode": "tap", "lap": 8, "enter": "flash",
      "look": { "palette": "deep", "zoom": [1.12, 0.95] },
      "gen": { "N": { "grid": 4, "n": 1, "force": [0] }, "H": { "grid": 4, "n": 1, "force": [0] }, "I": { "grid": 4, "n": 1, "force": [0] } } }
  ]
}
