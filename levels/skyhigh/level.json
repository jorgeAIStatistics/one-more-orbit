{
  "_doc": [
      "Level layout for a one-button level. Segments play in order; 'bars' is each one's length (keep the total at the excerpt's bar count),",
      "then re-run: python tools/chart.py skyhigh",
      "lap = beats per trip round a ring (smaller = faster: double-time; larger = half-time).  shape: circle | ellipse | square.",
      "jump: out (default) or in.  rocket: extra rings the ball launches through on entering.  reverse / revEvery: direction flips.",
      "look: palette, bg (stars | tunnel | grid), eq (bars | wave | burst), optional [from, to] ramps: zoom, rot (turns), tilt, drain, vignette; flip.",
      "follow: the ONE sound this section's taps follow (arp, kick, snare, lead); gate colour shows it. lead: which measured layer the L lane reads.",
      "motif / cycle: sections sharing a motif name are one repeating figure, charted identically every time.",
      "warn: label shown two beats before the section.  teach: banner the first time.  plan: one pattern per bar (vocabulary at the top of tools/chart.py)."
  ],
  "id": "skyhigh",
  "title": "Sky High",
  "artist": "Elektronomia",
  "release": "NCS Release",
  "hitsoundNote": 72,
  "scale": [0, 2, 3, 5, 7, 8, 10],
  "segments": [
    {"id": "intro", "bars": 4, "label": "INTRO", "lap": 8, "follow": "arp", "lead": "snare", "motif": "intro", "cycle": 4, "teach": "TAP as the ball crosses each gate", "look": {"palette": "deep", "bg": "stars", "eq": "bars", "zoom": [0.9, 1]},
      "plan": ["L=beat"] },
    {"id": "intro2", "bars": 4, "label": "INTRO", "lap": 8, "follow": "arp", "lead": "snare", "motif": "intro", "cycle": 4, "look": {"palette": "ocean", "bg": "stars", "eq": "bars"},
      "plan": ["L=beat"] },
    {"id": "verse", "bars": 4, "label": "VERSE", "lap": 8, "follow": "arp", "lead": "snare", "motif": "verse", "cycle": 4, "shape": "ellipse", "warn": "FLIP GATE", "teach": "FLIP GATE: tapping it turns the ball round", "look": {"palette": "violet", "bg": "tunnel", "eq": "wave"},
      "plan": ["L=8 flip", "L=8", "L=8", "L=8"] },
    {"id": "ghost", "bars": 4, "label": "VERSE", "lap": 8, "follow": "arp", "lead": "snare", "motif": "verse", "cycle": 4, "shape": "ellipse", "warn": "PORTALS", "teach": "PORTAL: tap it to jump across the ring", "look": {"palette": "violet", "bg": "tunnel", "eq": "wave", "rot": [0, 0.25]},
      "plan": ["L=8 portal", "L=8", "L=8 portal", "L=8"] },
    {"id": "spikes", "bars": 4, "label": "BUILD", "lap": 4, "follow": "kick", "jump": "in", "warn": "SPIKES", "teach": "SPIKES: tap the arrow to hop over", "look": {"palette": "dusk", "bg": "grid", "eq": "bars", "zoom": [1, 1.06]},
      "plan": ["B=@x...x.......x... hop", "B=@x...x...x....... hop", "B=@x...x...x...x... hop", "B=@x...x...x...x.x. hop"] },
    {"id": "rush", "bars": 2, "label": "BUILD", "lap": 2, "follow": "snare", "lead": "snare", "jump": "in", "mini": true, "warn": "MINI MODE", "look": {"palette": "dusk", "bg": "grid", "eq": "bars", "zoom": [1.06, 1.14], "drain": [0, 0.5], "vignette": [0, 0.5]},
      "plan": ["L=@x.x.x.x.x.x.x.x."] },
    {"id": "roll", "bars": 2, "label": "BUILD", "lap": 2, "follow": "snare", "lead": "full", "jump": "in", "look": {"palette": "dusk", "bg": "grid", "eq": "bars", "zoom": [1.14, 1.25], "drain": [0.5, 0.95], "vignette": [0.5, 0.9]},
      "plan": ["L=@x.x.x.x.x.x.x.x.", "L=@x.x.x.x.x.x.xxx."] },
    {"id": "count", "bars": 1, "label": "READY", "lap": 4, "follow": "kick", "blackout": true, "count": true, "jump": "in", "look": {"palette": "dusk", "bg": "stars", "eq": "bars", "zoom": [1.25, 1.3], "drain": [1, 1], "vignette": [0.9, 1]},
      "plan": ["B=@............X.x."] },
    {"id": "drop1", "bars": 4, "label": "DROP", "lap": 4, "follow": "lead", "lead": "hook", "motif": "drop", "cycle": 4, "shape": "square", "rocket": 4, "sling": [1, -0.3], "enter": "drop", "look": {"palette": "neon", "bg": "tunnel", "eq": "burst", "zoom": [0.94, 1]},
      "plan": ["L=16 acc", "L=16", "L=16", "L=16"] },
    {"id": "drop2", "bars": 4, "label": "DROP", "lap": 4, "follow": "lead", "lead": "hook", "motif": "drop", "cycle": 4, "shape": "square", "enter": "pulse", "look": {"palette": "aqua", "bg": "tunnel", "eq": "burst"},
      "plan": ["L=16 acc", "L=16", "L=16", "L=16"] },
    {"id": "drop3", "bars": 4, "label": "DROP", "lap": 4, "follow": "lead", "lead": "hook", "motif": "drop", "cycle": 4, "shape": "square", "rocket": 2, "enter": "pulse", "warn": "FLIP GATES", "look": {"palette": "gold", "bg": "grid", "eq": "burst", "rot": [0, 1]},
      "plan": ["L=16 flip", "L=16 flip", "L=16 flip", "L=16 flip"] },
    {"id": "drop4", "bars": 4, "label": "DROP", "lap": 4, "follow": "lead", "lead": "hook", "motif": "drop", "cycle": 4, "shape": "circle", "sling": [-1, 0.25], "enter": "pulse", "look": {"palette": "hot", "bg": "tunnel", "eq": "burst", "zoom": [1, 1.1], "flip": true},
      "plan": ["L=16 acc", "L=16", "L=16", "L=16"] },
    {"id": "outro", "bars": 1, "label": "END", "lap": 8, "follow": "kick", "rocket": 6, "enter": "flash", "look": {"palette": "deep", "bg": "stars", "eq": "wave", "zoom": [1.1, 0.95]},
      "plan": ["B=@X..............."] }
  ]
}
