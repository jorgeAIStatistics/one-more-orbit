{
  "name": "one-more-orbit",
  "private": true,
  "version": "1.0.0-rc.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "phone": "npm run build && vite preview --host --port 4173",
    "build:single": "tsc --noEmit && vite build --mode single && node tools/build-single.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@fontsource/unbounded": "^5.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.0"
  }
}
