{
  "name": "one-more-orbit",
  "private": true,
  "version": "1.1.0-beta.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "phone": "npm run build && vite preview --host --port 4173",
    "build:single": "tsc --noEmit && vite build --mode single && node tools/build-single.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "icons": "python3 tools/make-icons.py",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "build:checks": "tsc --noEmit && vite build --mode checks"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "playwright-core": "^1.65.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/cormorant-sc": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "omo-game-center": "file:plugins/game-center"
  }
}
